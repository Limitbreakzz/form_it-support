# Environment Configuration for IT Support Record Management Web App
# Copy this file to .env and paste your deployed Google Apps Script Web App URL below.
# You can also configure or update the Web App URL directly inside the application's UI under "Google Sheets API Setup".

VITE_GAS_WEB_APP_URL=

# Optional: Override LAN Backend API URL (defaults automatically to http://<current-host>:4100)
# VITE_BACKEND_API_URL=http://192.168.1.130:4100


